# =============================================================================
# Variables de entorno del backend.
# Copia este archivo como .env y rellena los valores reales.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).
# =============================================================================

# Puerto donde escucha el servidor Express.
PUERTO=3000

# Entorno de ejecución: desarrollo | produccion
# En produccion el middleware de errores oculta la traza interna.
NODE_ENV=desarrollo

# Ruta del archivo de base de datos SQLite, relativa a la carpeta backend/.
RUTA_BASE_DATOS=./datos/juego.db

# Orígenes autorizados por CORS, separados por comas.
# 5500 es el puerto que usa Live Server de VS Code; 8080 y 5173 son los de
# otros servidores estáticos habituales. Si el navegador se queja de CORS,
# el origen que aparece en el error tiene que estar en esta lista.
# Si se deja VACÍA se permite cualquier origen: solo para desarrollo.
ORIGENES_PERMITIDOS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# Clave que autoriza las operaciones destructivas (DELETE y PUT).
# El cliente la envía en la cabecera x-clave-api.
# Cámbiala por un valor largo y aleatorio antes de desplegar.
CLAVE_API=cambia-esta-clave-antes-de-desplegar

# Número de filas que devuelve la tabla de puntuaciones por defecto.
LIMITE_PUNTUACIONES=10

# -----------------------------------------------------------------------------
# MODELO DE LENGUAJE (opcional)
#
# Mueve la dificultad EL GENIO y el chatbot que explica cómo se juega.
# Si IA_CLAVE se deja VACÍA, las dos cosas siguen funcionando con respuestas
# de repuesto escritas a mano: el juego se puede jugar y corregir entero sin
# pagar ninguna API.
#
# IMPORTANTE: la clave va AQUÍ y solo aquí. Nunca en el código del frontend,
# porque cualquiera puede leer el JavaScript de una página web. El navegador
# le habla a /api/mente y es el servidor quien llama al proveedor.
# El archivo .env no se sube al repositorio (está en .gitignore).
#
# IA_URL_BASE acepta cualquier proveedor con formato OpenAI. Ejemplos:
#   OpenAI      https://api.openai.com/v1                 (gpt-4o-mini)
#   Groq        https://api.groq.com/openai/v1            (el modelo que ofrezca tu cuenta)
#   OpenRouter  https://openrouter.ai/api/v1              (google/gemini-flash-1.5)
#   Ollama      http://localhost:11434/v1                 (llama3.2)  ← sin coste
# Para Gemini, Google ofrece una ruta compatible con OpenAI:
#   https://generativelanguage.googleapis.com/v1beta/openai
#
# Los modelos gratuitos de cada proveedor cambian: mira en su web cuáles hay.
#
# CON OLLAMA no hace falta cuenta ni clave, pero IA_CLAVE no puede quedarse
# vacía (vacía significa "sin IA"): pon cualquier texto, por ejemplo
#   IA_URL_BASE=http://localhost:11434/v1
#   IA_CLAVE=ollama
#   IA_MODELO=llama3.2
#   IA_TIEMPO_LIMITE_MS=20000
# La URL termina en /v1, no en /api. Si el Ollama está en otro equipo y lo
# compartes con un túnel (ngrok, Cloudflare Tunnel), pon aquí la dirección del
# túnel seguida de /v1 y NO la subas al repositorio: quien la tenga usa tu PC.
# -----------------------------------------------------------------------------
IA_URL_BASE=https://api.openai.com/v1
IA_CLAVE=
IA_MODELO=gpt-4o-mini

# Milisegundos que se espera al proveedor antes de rendirse y usar el plan B.
# 6000 va bien con un proveedor en la nube. Con Ollama en un portátil normal,
# o a través de un túnel, sube a 20000: la primera respuesta carga el modelo en
# memoria y tarda bastante más que las siguientes. No pases de 25000, porque el
# navegador se rinde a los 30000.
IA_TIEMPO_LIMITE_MS=6000
